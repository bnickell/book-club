# Copy to .env.local and fill in. Never commit .env.local.

# ---- Required: Supabase (Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# "anon" / publishable key -- safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_anon_key_here
# "service_role" / secret key -- SERVER ONLY. Keep it secret; bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_role_key_here

# ---- Required: Anthropic (console.anthropic.com -> API Keys) ----
# Powers book recommendations and weekly discussion guides.
ANTHROPIC_API_KEY=sk-ant-api03-your_key_here
# Optional: override the model (default: claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Required: App URL, used in welcome-email sign-in links ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Optional branding / access ----
# Display name shown in the nav, landing page and emails (default: "Book Club")
# NEXT_PUBLIC_APP_NAME=Acme Book Club
# Restrict sign-up to these email domains (comma-separated). Leave unset to let
# anyone request access (admins still approve everyone). If you set this, also
# add the same domains to the allowed_email_domains table -- see README.
# NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=example.com,example.org
